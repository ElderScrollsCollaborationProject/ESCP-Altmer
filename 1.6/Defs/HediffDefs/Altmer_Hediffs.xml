<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Altmer_Highborn</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>Highborn</label>
        <description>Aldmeri blood is pouring magicka back into this person much faster than normal.</description>
        <defaultLabelColor>(0.95, 0.85, 0.45)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800~1800</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <ESCP_MagickaRegen>8</ESCP_MagickaRegen>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

</Defs>
