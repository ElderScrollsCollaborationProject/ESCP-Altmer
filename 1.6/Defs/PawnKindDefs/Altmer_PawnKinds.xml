        <defaultFactionDef>ESCP_Faction_Aldmeri_Dominion</defaultFactionDef>
        <xenotypeSet>
            <xenotypeChances>
                <ESCP_Xenotype_Altmer MayRequire="Ludeon.RimWorld.Biotech">1</ESCP_Xenotype_Altmer>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <maxGenerationAge>65</maxGenerationAge>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>Pemmican</invFoodDef>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

