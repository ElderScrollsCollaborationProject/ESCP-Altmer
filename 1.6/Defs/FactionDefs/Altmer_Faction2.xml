<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Thalmor</defName>
        <label>Thalmor</label>
        <description>The Thalmor began as one political party on Summerset and now write the Dominion's foreign policy with a very sharp pen. Embassies keep files, Justiciars pay calls, and a great many people who prayed to Talos have stopped doing it where anyone can hear. They believe the world is a prison built by a lesser god, and they intend to do something about that.</description>
        <colorSpectrum>
            <li>(0.55, 0.62, 0.25)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Altmer</pawnSingular>
        <pawnsPlural>Altmer</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.2</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>First Emissary</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>Thalmor</fixedName>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_NineDivines</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Structure_OriginDivinesNine</li>
        </disallowedMemes>
        <allowedCultures>
            <li>ESCP_Culture_Altmer</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Altmer</li>
        </royalTitleTags>
        <royalFavorLabel>Thalmor Regard</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Thalmor Doctrine</ideoName>
        <ideoDescription>Mundus was a mistake and mortals are what came of it. Auri-El and the old Aldmeri gods were robbed of their divinity, and the doctrine holds that the theft can still be undone. Talos, a man claiming a god's seat, is therefore not merely wrong but an active obstacle, and the Thalmor treat him accordingly.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Auri-El</name><type>king of the Aldmeri gods</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityAuriEl</iconPath>
            </li>
            <li>
                <nameType><name>Trinimac</name><type>champion of the old gods</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityTrinimac</iconPath>
            </li>
            <li>
                <nameType><name>Magnus</name><type>the sorcerer who left the world</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityMagnus</iconPath>
            </li>
            <li>
                <nameType><name>Syrabane</name><type>patron of young mages</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeitySyrabane</iconPath>
            </li>
            <li>
                <nameType><name>Phynaster</name><type>who taught the Altmer to live a hundred years longer</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Xarxes</name><type>scribe of the gods and keeper of histories</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityXarxes</iconPath>
            </li>
            <li>
                <nameType><name>Mafala</name><type>secret teacher of the Psijic path</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Altmer</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_AldmeriWay</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Altmer_Child</li>
                    <li>ESCP_Backstory_Altmer_Citizen</li>
                    <li>ESCP_Backstory_Altmer_Military</li>
                    <li>ESCP_Backstory_Altmer_Mage</li>
                </categories>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Altmer_Trader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Altmer_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Altmer_Trader</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-20~50</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Altmer_Melee>10</ESCP_Pawnkind_Altmer_Melee>
                    <ESCP_Pawnkind_Altmer_Ranged>7</ESCP_Pawnkind_Altmer_Ranged>
                    <ESCP_Pawnkind_Altmer_Mage>9</ESCP_Pawnkind_Altmer_Mage>
                    <ESCP_Pawnkind_Altmer_Captain>3</ESCP_Pawnkind_Altmer_Captain>
                    <ESCP_Pawnkind_Altmer_Elite>2</ESCP_Pawnkind_Altmer_Elite>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Altmer_Citizen>15</ESCP_Pawnkind_Altmer_Citizen>
                    <ESCP_Pawnkind_Altmer_Merchant>6</ESCP_Pawnkind_Altmer_Merchant>
                    <ESCP_Pawnkind_Altmer_Noble>4</ESCP_Pawnkind_Altmer_Noble>
                    <ESCP_Pawnkind_Altmer_Mage>3</ESCP_Pawnkind_Altmer_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Altmer_Trader>1</ESCP_Pawnkind_Altmer_Trader>
                    <ESCP_Pawnkind_Altmer_Quartermaster>1</ESCP_Pawnkind_Altmer_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Altmer_Melee>8</ESCP_Pawnkind_Altmer_Melee>
                    <ESCP_Pawnkind_Altmer_Ranged>5</ESCP_Pawnkind_Altmer_Ranged>
                    <ESCP_Pawnkind_Altmer_Elite>1</ESCP_Pawnkind_Altmer_Elite>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Altmer_Citizen>8</ESCP_Pawnkind_Altmer_Citizen>
                    <ESCP_Pawnkind_Altmer_Melee>10</ESCP_Pawnkind_Altmer_Melee>
                    <ESCP_Pawnkind_Altmer_Ranged>8</ESCP_Pawnkind_Altmer_Ranged>
                    <ESCP_Pawnkind_Altmer_Mage>4</ESCP_Pawnkind_Altmer_Mage>
                    <ESCP_Pawnkind_Altmer_Elite>2</ESCP_Pawnkind_Altmer_Elite>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_Aldmeri</li>
                    <li>ESCP_Thalmor</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Thalmor</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li MayRequire="Rick.ESCP.Imperials">ESCP_Faction_Imperial</li>
                </hostileFactionDefs>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Thalmor Embassy</li>
                    <li>Northwatch Keep</li>
                    <li>Firsthold</li>
                    <li>Dusk</li>
                    <li>Traitor's Tor</li>
                    <li>Sil-Var-Woad</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>TemperateForest</li>
                    <li>BorealForest</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_Thalmor</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_Thalmor</li>
                </rankTracks>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
